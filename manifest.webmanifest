{
  "name": "Orbital Network Atlas",
  "short_name": "Orbital Atlas",
  "description": "Live 3D atlas of satellite-to-ground-station data links: networking constellations propagated from current orbital elements, gateways, teleports and the SatNOGS open network, with a similarity map, coverage heatmap and build-out timeline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#03060c",
  "theme_color": "#03060c",
  "categories": ["education", "science", "utilities"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Similarity map", "url": "./#similarity", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Globe + similarity", "url": "./#both", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]}
  ]
}
